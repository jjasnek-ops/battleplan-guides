---
/** Each unit owns its atOptions in public/ads/<name>.html. No top-navigation permission. */
import { currentSharedStrings } from '~/lib/shared-ui';
import { trackingRequiresConsent } from '~/config/monetization';

interface Props {
  name: string;
  /** Zero means a responsive Native unit. Fixed creatives are never scaled. */
  width: number;
  height: number;
  label?: boolean;
  hideOnMobile?: boolean;
  minViewportWidth?: number;
  maxViewportWidth?: number;
  minViewportHeight?: number;
}
const {
  name,
  width,
  height,
  label = true,
  hideOnMobile = false,
  minViewportWidth = hideOnMobile ? 768 : 0,
  maxViewportWidth = 100000,
  minViewportHeight = 0,
} = Astro.props;
const show = !!import.meta.env[`PUBLIC_ADSTERRA_SLOT_${name.replace(/-/g, '_').toUpperCase()}`];
const consentBannerActive =
  trackingRequiresConsent &&
  !!(import.meta.env.PUBLIC_GA_ID || import.meta.env.PUBLIC_ADSENSE_CLIENT);
const adLabel = currentSharedStrings(Astro.currentLocale).adLabel ?? 'Advertisement';
---

{
  show && (
    <div
      class="adsterra-slot not-prose"
      data-ad-unit={name}
      data-ad-width={width}
      data-ad-min-width={minViewportWidth}
      data-ad-max-width={maxViewportWidth}
      data-ad-min-height={minViewportHeight}
      data-ad-requires-consent={String(consentBannerActive)}
      data-pagefind-ignore
      hidden
    >
      {label && (
        <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">
          {adLabel}
        </span>
      )}
      <iframe
        data-src={`/ads/${name}.html`}
        width={width || undefined}
        height={height}
        style={width ? `width:${width}px;height:${height}px` : `width:100%;height:${height}px`}
        sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
        title={adLabel}
      />
    </div>
  )
}
<script>
  import { CONSENT_STORAGE_KEY, CONSENT_ACCEPTED_EVENT } from '~/lib/shared-ui';
  import { canLoadAd } from '~/lib/ad-visibility';
  const loadedUnits = new Set<string>();
  let accepted = false;
  try {
    accepted = localStorage.getItem(CONSENT_STORAGE_KEY) === 'accepted';
  } catch {
    /* Automatic mode does not depend on storage. */
  }
  const refreshers: Array<() => void> = [];
  document.addEventListener(CONSENT_ACCEPTED_EVENT, () => {
    accepted = true;
    refreshers.forEach((refresh) => refresh());
  });
  document.querySelectorAll<HTMLElement>('[data-ad-unit]').forEach((slot) => {
    const frame = slot.querySelector('iframe');
    const parent = slot.parentElement;
    const unit = slot.dataset.adUnit;
    if (!frame || !parent || !unit) return;
    let inView = false;
    const dimensions = () => {
      const style = getComputedStyle(parent);
      return {
        viewportWidth: window.innerWidth,
        viewportHeight: window.innerHeight,
        containerWidth: Math.max(
          0,
          parent.clientWidth -
            parseFloat(style.paddingLeft || '0') -
            parseFloat(style.paddingRight || '0'),
        ),
        creativeWidth: Number(slot.dataset.adWidth),
        minViewportWidth: Number(slot.dataset.adMinWidth),
        maxViewportWidth: Number(slot.dataset.adMaxWidth),
        minViewportHeight: Number(slot.dataset.adMinHeight),
        requiresConsent: slot.dataset.adRequiresConsent === 'true',
        accepted,
        inView,
      };
    };
    const refresh = () => {
      const state = dimensions();
      slot.hidden = !canLoadAd({ ...state, accepted: true, requiresConsent: false, inView: true });
      if (!canLoadAd(state) || frame.hasAttribute('src')) return;
      if (loadedUnits.has(unit)) {
        slot.hidden = true;
        return;
      }
      loadedUnits.add(unit);
      frame.src = frame.dataset.src ?? '';
      frame.dataset.adLoaded = 'true';
    };
    refreshers.push(refresh);
    refresh();
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          inView = entries.some((entry) => entry.isIntersecting);
          refresh();
        },
        { threshold: 0.01 },
      ).observe(slot);
    } else {
      inView = true;
      refresh();
    }
    if ('ResizeObserver' in window) new ResizeObserver(refresh).observe(parent);
    window.addEventListener('resize', refresh, { passive: true });
  });
  window.addEventListener('message', (event) => {
    if (event.origin !== window.location.origin || event.data?.type !== 'adsterra:resize') return;
    const height = Number(event.data.height);
    if (!Number.isFinite(height) || height < 40 || height > 1600) return;
    document
      .querySelectorAll<HTMLIFrameElement>('[data-ad-unit="native-banner"] iframe')
      .forEach((frame) => {
        if (event.source === frame.contentWindow) frame.style.height = `${Math.ceil(height)}px`;
      });
  });
</script>
